[
    {
      "selector": "node",
      "style": {
        "shape": "rectangle",
        "height": "16px",
        "width": "16px",
        "background-image": "data(img)",
        "background-fit": "contain",
        "background-color": "#000",
        "background-opacity": 1,
        "outline-width": 0.6,
        "outline-color": "#3d1f3d",
        "label": "data(label)",
        "font-size": 4.5,
        "text-justification": "center",
        "text-wrap": "wrap",
        "text-max-width": "30px",
        "text-margin-y": 2,
        "color": "#fff",
        "text-outline-color": "#000",
        "text-outline-width": 0.5,
        "text-valign": "bottom",
        "text-halign": "center"
      }
    },
    {
      "selector": "[id < '100']",
      "style": {
        "outline-width": 0,
        "background-image": "https://moxisweb.github.io/drmv/img/flowey_icon_1x1.png",
        "shape": "polygon",
        "shape-polygon-points": "0 -0.6 0.5 -0.65 1 -0.1 0.8 0.2 0.85 0.5 0.6 0.65 0 0.55 -0.6 0.65 -0.85 0.5 -0.8 0.2 -1 -0.1 -0.5 -0.65",
        "height": "10px",
        "width": "10px",
        "background-clip": "none",
        "bounds-expansion": "5px"
      }
    },
    {
      "selector": "[id > '799']",
      "style": {
        "text-overflow-wrap": "anywhere",
        "outline-width": 0,
        "background-image": "https://moxisweb.github.io/drmv/img/file_icon.png",
        "shape": "polygon",
        "shape-polygon-points": "0.3 -1 1 -0.44 1 1 -1 1 -1 -1",
        "height": "8px",
        "width": "6px"
      }
    },
    {
      "selector": "[id > '899']",
      "style": {
        "text-overflow-wrap": "whitespace",
        "shape": "diamond",
        "background-image": "none",
        "background-color": "White",
        "height": "5px",
        "width": "5px"
      }
    },
    {
      "selector": ".none",
      "style": {
        "opacity": "0.3"
      }
    },
    {
      "selector": ".hidden",
      "style": {
        "display": "none"
      }
    },
    {
      "selector": "edge",
      "style": {
        "width": 0.7,
        "line-color": "LightGrey",
        "opacity": 0.6,
        "curve-style": "bezier",
        "control-point-step-size": 4,
        "target-arrow-color": "LightGrey",
        "target-arrow-shape": "triangle",
        "arrow-scale": 0.35,
        "target-distance-from-node": 2,
        "target-endpoint": "outside-to-line-or-label"
      }
    },
    {
      "selector": ".weak",
      "style": {
        "line-style": "dashed",
        "line-dash-pattern": [1, 1],
        "width": 0.5
      }
    },
